# Copy to .env.local (local) or set in Vercel → Settings → Environment Variables.

# Postgres. Local: `npm run db:up` starts one on 55432. Production: Neon (pooled connection string).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/english_coach

# Random 32+ byte secret for Better Auth: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public base URL of the app (production: https://<your-app>.vercel.app). Also defines the MCP resource <url>/mcp.
BETTER_AUTH_URL=http://localhost:3000

# The only account allowed into the app and the MCP connection.
ALLOWED_EMAIL=you@example.com
