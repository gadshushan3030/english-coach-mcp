# Copy to .env.local (local) or set in Vercel → Settings → Environment Variables.
# Local values: run `supabase status`. Hosted: Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# The publishable (anon) key only. Never put the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The only account allowed into the app.
ALLOWED_EMAIL=you@example.com
